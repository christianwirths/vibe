#!/usr/bin/env python3
"""vibe mon - a compact, always-on terminal dashboard for Claude Code agents + SLURM jobs.

Dependency-free (standard library only). Meant to sit in a corner terminal and refresh in
place. Reads the shared ~/.claude state, so it sees every session on the node it runs on
(vibe hops it to the home node). Quit with 'q' or Ctrl-C.

NOTE on "usage": Claude Code does not persist your live rate-limit consumption to disk
anywhere readable, so the THROUGHPUT panel shows recent output-token activity as a relative
proxy, not the official percent-of-limit gauge.
"""
import os, sys, re, glob, json, time, socket, subprocess, select, shutil, getpass, threading, fcntl
import urllib.request, urllib.error
from email.utils import parsedate_to_datetime
from datetime import datetime, timezone

HOME = os.path.expanduser("~")
SESS_DIR = os.path.join(HOME, ".claude", "sessions")
PROJ_DIR = os.path.join(HOME, ".claude", "projects")
USER = getpass.getuser()
TAIL_BYTES = 256 * 1024          # how much of each transcript tail to parse
RECENT_WINDOW = 300              # seconds counted as "recent" for throughput
ACTIVE_WINDOW = 25               # seconds since last event to count a session "active"
CACHE_TTL = float(os.environ.get("VIBE_CACHE_TTL", 3600))  # prompt-cache TTL; idle past this = decached
_CTX_ENV = os.environ.get("VIBE_CTX_WINDOW")
CTX_WINDOW = float(_CTX_ENV) if _CTX_ENV else 0.0  # 0 = adaptive per agent (200k, else 1M)

NO_COLOR = bool(os.environ.get("NO_COLOR"))
def c(code, s):
    return s if NO_COLOR else f"\033[{code}m{s}\033[0m"
BOLD="1"; DIM="2"; RED="31"; GRN="32"; YEL="33"; BLU="34"; MAG="35"; CYN="36"; GRY="90"

def vpad(s, width, color=None):
    """Truncate/pad a PLAIN string to visible width, then colorize (so color codes
    never corrupt column alignment)."""
    s = str(s)
    if len(s) > width:
        s = s[:width-1] + "…"
    s = s + " " * (width - len(s))
    return c(color, s) if color else s

def now_utc():
    return datetime.now(timezone.utc)

def parse_ts(s):
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00"))
    except Exception:
        return None

def domain():
    try:
        f = socket.getfqdn()
        return f.split(".", 1)[1] if "." in f else ""
    except Exception:
        return ""

def read_sessions():
    out = []
    for f in glob.glob(os.path.join(SESS_DIR, "*.json")):
        try:
            d = json.load(open(f))
            out.append(d)
        except Exception:
            continue
    return out

def pid_alive(pid):
    try:
        p = f"/proc/{int(pid)}"
        if not os.path.isdir(p):
            return False
        comm = open(os.path.join(p, "comm")).read().strip()
        return comm in ("claude", "node")
    except Exception:
        return False

def transcript_for(session_id):
    hits = glob.glob(os.path.join(PROJ_DIR, "*", f"{session_id}.jsonl"))
    if not hits:
        return None
    return max(hits, key=lambda p: os.path.getmtime(p))

def tail_events(path):
    """Return parsed JSON events from the tail of a transcript."""
    try:
        sz = os.path.getsize(path)
        with open(path, "rb") as fh:
            if sz > TAIL_BYTES:
                fh.seek(sz - TAIL_BYTES)
                fh.readline()  # drop partial first line
            data = fh.read().decode("utf-8", "replace")
    except Exception:
        return []
    evs = []
    for ln in data.splitlines():
        ln = ln.strip()
        if not ln:
            continue
        try:
            evs.append(json.loads(ln))
        except Exception:
            continue
    return evs

def describe_activity(ev):
    """Human label of what the last assistant turn is doing."""
    try:
        content = ev.get("message", {}).get("content", [])
        tools = [b.get("name") for b in content if isinstance(b, dict) and b.get("type") == "tool_use"]
        types = [b.get("type") for b in content if isinstance(b, dict)]
        if tools:
            return "run " + ",".join(t for t in tools if t)[:22]
        if "thinking" in types:
            return "thinking"
        if "text" in types:
            return "writing"
    except Exception:
        pass
    return "-"

def agent_stats(session_id):
    path = transcript_for(session_id)
    if not path:
        return None
    evs = tail_events(path)
    if not evs:
        return {"path": path, "last_ts": None, "doing": "-", "recent_tok": 0, "tail_tok": 0, "model": "-", "branch": "-", "ctx": 0}
    last_ts = None
    recent_tok = 0
    tail_tok = 0
    last_assist = None
    model = "-"
    branch = "-"
    cutoff = now_utc().timestamp() - RECENT_WINDOW
    for ev in evs:
        ts = parse_ts(ev.get("timestamp", "")) if isinstance(ev.get("timestamp"), str) else None
        if ts and (last_ts is None or ts > last_ts):
            last_ts = ts
        if ev.get("gitBranch"):
            branch = ev["gitBranch"]
        if ev.get("type") == "assistant":
            last_assist = ev
            m = ev.get("message", {})
            if m.get("model"):
                model = str(m["model"]).replace("claude-", "")
            ot = 0
            try:
                ot = int(m.get("usage", {}).get("output_tokens", 0))
            except Exception:
                ot = 0
            tail_tok += ot
            if ts and ts.timestamp() >= cutoff:
                recent_tok += ot
    doing = describe_activity(last_assist) if last_assist else "-"
    ctx = 0
    if last_assist:
        u = last_assist.get("message", {}).get("usage", {}) or {}
        ctx = (u.get("input_tokens") or 0) + (u.get("cache_read_input_tokens") or 0) + (u.get("cache_creation_input_tokens") or 0)
    return {"path": path, "last_ts": last_ts, "doing": doing, "recent_tok": recent_tok,
            "tail_tok": tail_tok, "model": model, "branch": branch, "ctx": ctx}

def squeue_jobs():
    try:
        r = subprocess.run(
            ["squeue", "-u", USER, "-h", "-o", "%i|%T|%M|%D|%R|%j"],
            capture_output=True, text=True, timeout=6)
    except subprocess.TimeoutExpired:
        return None, "squeue timeout"
    except FileNotFoundError:
        return [], "no squeue"
    except Exception as e:
        return None, f"squeue err: {e}"
    jobs = []
    for ln in r.stdout.splitlines():
        parts = ln.split("|")
        if len(parts) >= 6:
            jid, st, tm, nds, reason, name = parts[:6]
            jobs.append({"id": jid, "st": st, "time": tm, "nodes": nds,
                         "reason": reason, "name": name})
    return jobs, None

def node_reach(host, port=22, timeout=1.2):
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except Exception:
        return False

# --- per-user task / memory cap ----------------------------------------------
# UBELIX submit nodes cap each user's cgroup (user-<uid>.slice) at ~750 tasks - every THREAD
# counts, not just processes - and ~25 GiB. At the task cap no new thread can start and Claude
# aborts ("Aborted (core dumped)"), taking down every session on the node at once. The TASKS
# panel shows the cap and which process groups use it.
UID = os.getuid()
SHELLS = {"bash", "sh", "zsh", "dash", "fish"}
TRIVIAL = {"sleep", "tail", "head", "cut", "sed", "grep", "awk", "cat", "tee", "wc", "xargs"}  # never name a group
BG_TASK = re.compile(r"claude-[0-9a-f]+-cwd")  # Claude Code's background-Bash wrapper shell
_CAP = {"pids_ev": None, "oom_ev": None, "pids_hit_t": 0.0, "pids_new": 0, "oom_hit_t": 0.0, "oom_new": 0}

def user_cgroup():
    """This user's slice in the cgroup-v2 tree (holds the per-user caps), or None."""
    try:
        rel = next(ln[3:].strip() for ln in open("/proc/self/cgroup") if ln.startswith("0::"))
    except Exception:
        return None
    d = "/sys/fs/cgroup" + rel
    while d.startswith("/sys/fs/cgroup/"):
        if os.path.basename(d) == f"user-{UID}.slice":
            return d
        d = os.path.dirname(d)
    return None

def _cg(d, name):
    try:
        return open(os.path.join(d, name)).read().strip()
    except Exception:
        return None

def _cg_int(d, name, key=None):
    """An integer cgroup value; with `key`, from a `key value` file such as pids.events.
    None if absent or 'max' (unlimited)."""
    txt = _cg(d, name) if d else None
    if txt is None:
        return None
    if key:
        txt = next((v for k, _, v in (ln.partition(" ") for ln in txt.splitlines()) if k == key), None)
    try:
        return int(txt)
    except (TypeError, ValueError):
        return None

def my_procs():
    """{pid: {ppid, name, threads, rss, argv}} for every process of this user, read from /proc."""
    out = {}
    for e in os.listdir("/proc"):
        if not e.isdigit():
            continue
        try:
            if os.stat(f"/proc/{e}").st_uid != UID:
                continue
            st = {}
            for ln in open(f"/proc/{e}/status"):
                k, _, v = ln.partition(":")
                if k in ("Name", "PPid", "Threads", "VmRSS"):
                    st[k] = v.strip()
            argv = open(f"/proc/{e}/cmdline", "rb").read().split(b"\0")
            out[int(e)] = {"pid": int(e), "ppid": int(st.get("PPid", 0)), "name": st.get("Name", "?"),
                           "threads": int(st.get("Threads", 1)),
                           "rss": int(st.get("VmRSS", "0 kB").split()[0]) * 1024,
                           "argv": [a.decode("utf-8", "replace") for a in argv if a]}
        except Exception:
            continue  # exited while we looked
    return out

def tmux_panes():
    """{pane shell pid: tmux session name} for this user's tmux server on this node."""
    try:
        r = subprocess.run(["tmux", "list-panes", "-a", "-F", "#{pane_pid} #{session_name}"],
                           capture_output=True, text=True, timeout=3)
    except Exception:
        return {}
    return {int(p): s for p, _, s in (ln.partition(" ") for ln in r.stdout.splitlines()) if p.isdigit()}

def session_label(s, procs, panes):
    """Name for a Claude session: its recorded tmux session, else the tmux pane it runs in,
    else its project folder."""
    lbl = str(s.get("tmux") or "").split(":")[0]
    if lbl:
        return lbl
    try:
        cur, hops = int(s.get("pid")), 0
    except Exception:
        cur, hops = None, 0
    while cur in procs and hops < 64:
        if cur in panes:
            return panes[cur]
        cur, hops = procs[cur]["ppid"], hops + 1
    cwd = str(s.get("cwd") or "").rstrip("/")
    return os.path.basename(cwd) if cwd else "sess-" + str(s.get("sessionId", ""))[:6]

def proc_label(p):
    """Readable name for a non-agent process: the script for interpreters, else the command."""
    argv, name = p["argv"], p["name"]
    joined = " ".join(argv)
    if ".vscode-server" in joined:
        return "vscode-server"
    if "vibe-mon" in joined:
        return "vibe mon"
    if name.startswith("tmux"):
        return "tmux"
    if name == "systemd":
        return "systemd --user"
    if name in SHELLS:  # `bash script.sh` -> script.sh; `bash -c ...` / interactive -> bash
        script = next((a for a in argv[1:] if not a.startswith("-")), None)
        return os.path.basename(script) if script and "-c" not in argv else name
    if name.startswith("python") or (argv and os.path.basename(argv[0]).startswith("python")):
        for i, a in enumerate(argv[1:], 1):
            if a == "-m" and i + 1 < len(argv):
                return argv[i + 1]
            if a.endswith(".py"):
                return os.path.basename(a)
        return "python"
    return name

def proc_where(p):
    """Folder a process runs in (basename), to tell same-named scripts of different projects apart."""
    try:
        cwd = os.readlink(f"/proc/{p['pid']}/cwd")
    except Exception:
        return "-"
    return "~" if cwd == HOME else os.path.basename(cwd.rstrip("/")) or "/"

def task_groups(procs, panes, agents):
    """Assign every process to a named group and sum its tasks (threads) and RSS.
    Walking up the parent chain, a process belongs to the first Claude session or tmux pane it
    finds (so a session's tool shells and background monitors count against that session);
    failing that, to its top-level ancestor. A top-level Claude background shell that was
    re-parented to init/systemd lost its session: it is an orphan, still holding tasks."""
    memo = {}
    def anchor(pid):
        path, cur, res = [], pid, None
        while res is None:
            if cur in memo:
                res = memo[cur]
            elif cur in agents:
                res = ("ses", agents[cur], True)
            elif cur in panes:
                res = ("ses", panes[cur], False)
            else:
                p = procs[cur]
                path.append(cur)
                par = procs.get(p["ppid"])
                if par is None or par["name"] == "systemd":
                    reaped = p["ppid"] == 1 or par is not None
                    orphan = reaped and (BG_TASK.search(" ".join(p["argv"])) or p["name"] == "claude")
                    res = ("orphan", cur, False) if orphan else ("root", cur, False)
                else:
                    cur = p["ppid"]
        for q in path:
            memo[q] = res
        return res

    groups = {}
    for pid, p in procs.items():
        typ, key, is_agent = anchor(pid)
        g = groups.setdefault((typ, key if typ != "orphan" else ""),
                              {"tasks": 0, "rss": 0, "procs": [], "agent": False, "roots": set()})
        g["tasks"] += p["threads"]
        g["rss"] += p["rss"]
        g["procs"].append(p)
        g["agent"] |= is_agent
        if typ == "orphan":
            g["roots"].add(key)

    rows = {}  # (label, where) -> row; same-named top-level groups merge (e.g. several vscode trees)
    for (typ, key), g in groups.items():
        if typ == "ses":
            label, where = key, ("claude" if g["agent"] else "tmux")
        elif typ == "orphan":
            label, where = f"orphaned bg x{len(g['roots'])}", "no session"
        else:
            # name the group after its heaviest real program; a tree of shells and sleep/tail is a
            # script loop, named after its top-level shell (e.g. watch_jobs.sh)
            heavy = [q for q in g["procs"] if q["name"] not in SHELLS | TRIVIAL]
            rep = max(heavy, key=lambda q: q["threads"]) if heavy else procs[key]
            label, where = proc_label(rep), proc_where(rep)
        r = rows.setdefault((label, where), {"label": label, "where": where, "tasks": 0, "rss": 0,
                                             "orphan": typ == "orphan", "roots": set()})
        r["tasks"] += g["tasks"]
        r["rss"] += g["rss"]
        r["roots"] |= g["roots"]
    return sorted(rows.values(), key=lambda r: -r["tasks"])

def bfmt(n):
    if n >= 1 << 30:
        return f"{n / (1 << 30):.1f}G"
    return f"{n / (1 << 20):.0f}M"

def tasks_panel(procs, panes, agents, maxrows=9):
    cg = user_cgroup()
    rows = task_groups(procs, panes, agents)
    cur = _cg_int(cg, "pids.current") or sum(r["tasks"] for r in rows)
    cap = _cg_int(cg, "pids.max")
    mcur, mcap = _cg_int(cg, "memory.current"), _cg_int(cg, "memory.max")
    # cap hits since this monitor started (the kernel counters are cumulative over the slice's life)
    now = time.time()
    for ev, fname, key, t_key, n_key in (("pids_ev", "pids.events", "max", "pids_hit_t", "pids_new"),
                                         ("oom_ev", "memory.events", "oom_kill", "oom_hit_t", "oom_new")):
        v = _cg_int(cg, fname, key)
        if v is None:
            continue
        if _CAP[ev] is not None and v > _CAP[ev]:
            _CAP[t_key], _CAP[n_key] = now, _CAP[n_key] + (v - _CAP[ev])
        _CAP[ev] = v

    if cap:
        pct = 100.0 * cur / cap
        bcol = RED if pct >= 85 else (YEL if pct >= 65 else GRN)
        head = c(YEL, " TASKS ") + f"{cur}/{cap} " + c(bcol, bar(pct, 12)) + f" {int(pct):>3}%"
    else:
        head = c(YEL, " TASKS ") + f"{cur} " + c(DIM, "(no per-user cap found)")
    if mcur is not None:
        head += c(DIM, f"  mem {bfmt(mcur)}" + (f"/{bfmt(mcap)}" if mcap else ""))
    p = [head]
    for t_key, n_key, what in (("pids_hit_t", "pids_new", "task cap HIT"), ("oom_hit_t", "oom_new", "OOM kill")):
        if _CAP[t_key]:
            ago = now - _CAP[t_key]
            p.append("  " + c(RED if ago < 900 else YEL, f"{what} {dur(ago)} ago (x{_CAP[n_key]} since mon start)"))
    p.append(c(DIM, "  " + "group".ljust(25) + "where".ljust(13) + "tasks".rjust(6) + "mem".rjust(7)))
    for r in rows[:maxrows]:
        share = r["tasks"] / cap if cap else 0
        col = RED if r["orphan"] else (YEL if share >= 0.25 else None)
        tasks_txt = f"{r['tasks']:>6}"
        p.append("  " + vpad(r["label"], 24, col) + " " + vpad(r["where"], 13, GRY)
                 + (c(col, tasks_txt) if col else tasks_txt) + f"{bfmt(r['rss']):>7}")
        if r["orphan"]:
            # each background shell leads its own process group, so -PID takes the whole tree
            roots = sorted(r["roots"])
            p.append("    " + c(RED, "kill -- " + " ".join(f"-{pid}" for pid in roots[:4]))
                     + (c(DIM, f" +{len(roots) - 4}") if len(roots) > 4 else ""))
    if len(rows) > maxrows:
        rest = rows[maxrows:]
        p.append(c(DIM, f"  + {len(rest)} more groups".ljust(40) + f"{sum(r['tasks'] for r in rest):>6}"))
    return p

# --- rate limits -----------------------------------------------------------
# Claude Code records a `quotaLimits` object in the transcript ONLY when a request
# is throttled/rejected (it carries rateLimitType, status, resetsAt). There is no
# continuous "% of limit" persisted on disk, so this reports throttle state + reset
# countdown per window, scanned from recent transcripts and cached.
_LIMIT_CACHE = {"t": 0.0, "data": {}}
LIMIT_LABEL = {"five_hour": "5h", "seven_day": "weekly", "weekly": "weekly", "monthly": "monthly"}

def scan_limits(max_files=40, days=14, every=20):
    now = time.time()
    if now - _LIMIT_CACHE["t"] < every:
        return _LIMIT_CACHE["data"]
    cutoff = now - days * 86400
    try:
        files = [f for f in glob.glob(os.path.join(PROJ_DIR, "*", "*.jsonl"))
                 if os.path.getmtime(f) >= cutoff]
        files.sort(key=os.path.getmtime, reverse=True)
    except Exception:
        files = []
    latest = {}  # rateLimitType -> (unix_ts, quota_dict)
    for f in files[:max_files]:
        try:
            sz = os.path.getsize(f)
            with open(f, "rb") as fh:
                if sz > 512 * 1024:
                    fh.seek(sz - 512 * 1024); fh.readline()
                data = fh.read()
        except Exception:
            continue
        if b"quotaLimits" not in data:
            continue
        for ln in data.decode("utf-8", "replace").splitlines():
            if "quotaLimits" not in ln:
                continue
            try:
                d = json.loads(ln)
            except Exception:
                continue
            q = d.get("quotaLimits")
            if not isinstance(q, dict):
                continue
            typ = q.get("rateLimitType", "?")
            ts = parse_ts(d.get("timestamp", "")) if isinstance(d.get("timestamp"), str) else None
            tv = ts.timestamp() if ts else 0.0
            if typ not in latest or tv > latest[typ][0]:
                latest[typ] = (tv, q)
    _LIMIT_CACHE["t"] = now
    _LIMIT_CACHE["data"] = latest
    return latest

def dur(secs):
    secs = int(max(0, secs))
    if secs < 3600:
        return f"{secs//60}m"
    if secs < 86400:
        return f"{secs//3600}h{(secs%3600)//60:02d}"
    return f"{secs//86400}d{(secs%86400)//3600:02d}h"

# --- live usage (the same data /usage draws) --------------------------------
# GET /api/oauth/usage returns {five_hour:{utilization,resets_at}, seven_day:{...}}.
# We use the OAuth token from ~/.claude/.credentials.json, refreshed by a background
# thread every USAGE_EVERY seconds so the UI never blocks. skip_spend=1 => free read.
USAGE_URL = os.environ.get(
    "VIBE_USAGE_URL", "https://api.anthropic.com/api/oauth/usage?at_wall=1&skip_spend=1")
USAGE_EVERY = float(os.environ.get("VIBE_USAGE_EVERY", 120))  # endpoint is itself rate-limited; poll gently
USAGE_BACKOFF = 300                                           # wait longer after a failure without Retry-After
# All monitors (any node, shared $HOME) share one cache file, so N monitors cost one request per
# USAGE_EVERY instead of N, and a fresh monitor shows bars at once. The file also keeps the
# last-known-good data across transient failures so the bars don't vanish on a blip.
USAGE_CACHE = os.path.join(HOME, ".cache", "vibe", "usage.json")
_USAGE = {"data": None, "ok_t": 0.0, "next_t": 0.0, "inflight": False, "err": None}

def oauth_token():
    try:
        d = json.load(open(os.path.join(HOME, ".claude", ".credentials.json")))
        return d.get("claudeAiOauth", {}).get("accessToken")
    except Exception:
        return None

def _read_cache():
    try:
        with open(USAGE_CACHE) as fh:
            return json.load(fh)
    except Exception:
        return {}

def _write_cache(d):
    try:
        os.makedirs(os.path.dirname(USAGE_CACHE), exist_ok=True)
        tmp = f"{USAGE_CACHE}.{socket.gethostname()}.{os.getpid()}.tmp"
        with open(tmp, "w") as fh:
            json.dump({k: d.get(k) for k in ("data", "ok_t", "next_t", "err")}, fh)
        os.replace(tmp, USAGE_CACHE)  # atomic: readers never see a half-written file
    except Exception:
        pass

def _claim():
    """True if this monitor should fetch now. Under a lock, re-check the shared schedule and,
    if due, push next_t forward so the other monitors stand down while we fetch."""
    try:
        os.makedirs(os.path.dirname(USAGE_CACHE), exist_ok=True)
        lk = open(USAGE_CACHE + ".lock", "a")
    except Exception:
        return True
    with lk:
        try:
            fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return False          # another monitor is claiming right now
        except OSError:
            pass                  # filesystem without flock: best effort
        sh = _read_cache()
        if time.time() < (sh.get("next_t") or 0):
            return False
        sh["next_t"] = time.time() + USAGE_EVERY  # if we die mid-fetch, others take over after this
        _write_cache(sh)
        return True

def _retry_after(v):
    """Seconds from a Retry-After header (delta-seconds or HTTP-date); None if absent/unparsable."""
    if not v:
        return None
    try:
        return max(0.0, float(v))
    except ValueError:
        pass
    try:
        return max(0.0, (parsedate_to_datetime(v) - now_utc()).total_seconds())
    except Exception:
        return None

def _do_fetch():
    try:
        if not _claim():
            return
        data, err, wait = None, None, None
        try:
            tok = oauth_token()
            if not tok:
                err = "no token"
            else:
                req = urllib.request.Request(USAGE_URL, headers={
                    "Authorization": f"Bearer {tok}",
                    "anthropic-beta": "oauth-2025-04-20",
                    "User-Agent": "vibe-mon",
                    "Accept": "application/json",
                })
                with urllib.request.urlopen(req, timeout=6) as r:
                    data = json.loads(r.read().decode("utf-8", "replace"))
        except urllib.error.HTTPError as e:
            err = f"HTTP {e.code}"
            wait = _retry_after(e.headers.get("Retry-After"))
        except Exception:
            err = "net error"
        now = time.time()
        sh = _read_cache()  # merge onto the latest shared state, keeping last-good data on failure
        if data is not None:
            sh.update(data=data, ok_t=now, err=None, next_t=now + USAGE_EVERY)
        else:
            # honour the server's Retry-After (never faster than our normal cadence); otherwise back off
            sh.update(err=err, next_t=now + (max(wait, USAGE_EVERY) if wait is not None else USAGE_BACKOFF))
        _write_cache(sh)
        _USAGE.update({k: sh.get(k) for k in ("data", "ok_t", "next_t", "err")})
    finally:
        _USAGE["inflight"] = False

def usage_cached():
    sh = _read_cache()
    if sh:
        _USAGE.update(data=sh.get("data"), ok_t=sh.get("ok_t") or 0.0,
                      next_t=sh.get("next_t") or 0.0, err=sh.get("err"))
    if not _USAGE["inflight"] and time.time() >= _USAGE["next_t"]:
        _USAGE["inflight"] = True
        try:
            threading.Thread(target=_do_fetch, daemon=True).start()
        except RuntimeError:          # "can't start new thread": at the task cap; try next tick
            _USAGE["inflight"] = False
    return _USAGE["data"]

def bar(pct, width=18):
    pct = max(0.0, min(100.0, float(pct)))
    filled = int(round(pct / 100.0 * width))
    return "█" * filled + "░" * (width - filled)

# ---------- rendering ----------
def hms(dt):
    if not dt:
        return "  -  "
    secs = int((now_utc() - dt).total_seconds())
    if secs < 0:
        secs = 0
    if secs < 60:
        return f"{secs}s"
    if secs < 3600:
        return f"{secs//60}m{secs%60:02d}"
    return f"{secs//3600}h{(secs%3600)//60:02d}"

def kfmt(n):
    if n >= 1_000_000:
        return f"{n/1e6:.1f}M"
    if n >= 1000:
        return f"{n/1e3:.1f}k"
    return str(int(n))

def short_path(p, n=22):
    if not p:
        return "-"
    p = p.replace(HOME, "~")
    return p if len(p) <= n else "..." + p[-(n-3):]

# --- responsive column layout ----------------------------------------------
_ANSI = re.compile(r"\033\[[0-9;]*m")
def vislen(s):
    return len(_ANSI.sub("", s))
def vfill(s, w):
    pad = w - vislen(s)
    return s + " " * pad if pad > 0 else s
def panel_w(p):
    return max((vislen(x) for x in p), default=0)

def columnize(panels, width, gutter=3, maxcols=3):
    """Pack panels (each a list of lines) into as many equal-width columns as `width`
    allows, balancing height (shortest-column masonry). Falls back to one column."""
    colw = max((panel_w(p) for p in panels), default=10)
    ncols = max(1, min(maxcols, (width + gutter) // (colw + gutter)))
    cols = [[] for _ in range(ncols)]
    heights = [0] * ncols
    for p in panels:
        i = heights.index(min(heights))
        if cols[i]:
            cols[i].append(""); heights[i] += 1
        cols[i].extend(p); heights[i] += len(p)
    if ncols == 1:
        return cols[0]
    H = max((len(cc) for cc in cols), default=0)
    out = []
    for r in range(H):
        parts = []
        for ci in range(ncols):
            cell = cols[ci][r] if r < len(cols[ci]) else ""
            if ci < ncols - 1:
                cell = vfill(cell, colw)
            parts.append(cell)
        out.append((" " * gutter).join(parts).rstrip())
    return out

def build(width):
    dom = domain()
    home_short = os.environ.get("VIBE_HOME_SHORT", "submit03")
    home_fqdn = f"{home_short}.{dom}" if dom else home_short
    try:
        socket.gethostbyname(home_fqdn); anchor = c(GRN, "ok")
    except Exception:
        anchor = c(RED, "UNRESOLVED")
    header = [
        f" vibe mon  {c(BOLD, socket.gethostname())}  {now_utc().astimezone().strftime('%H:%M:%S')}  home={home_short}[{anchor}]",
        c(GRY, "-" * min(width, 118)),
    ]
    panels = []

    # LIMITS: live usage bars from /api/oauth/usage; fall back to transcript throttle events
    usage = usage_cached()
    p = [c(MAG, " LIMITS ") + c(DIM, "Claude")]
    lims = (usage or {}).get("limits")
    if lims:
        # one bar per active limit window: 5h session, weekly (all), and any model-scoped
        # weekly (e.g. Fable). Source is the same `limits` array /usage renders.
        for lm in lims:
            pct = lm.get("percent")
            if pct is None:
                continue
            kind = lm.get("kind")
            if kind == "session":
                label = "5h"
            elif kind == "weekly_all":
                label = "wk:all"
            elif kind == "weekly_scoped":
                mname = ((lm.get("scope") or {}).get("model") or {}).get("display_name") or "scoped"
                label = f"wk:{mname}"
            else:
                label = kind or "?"
            r = parse_ts(lm.get("resets_at", "")) if isinstance(lm.get("resets_at"), str) else None
            cd = dur((r - now_utc()).total_seconds()) if r else "?"
            sev = lm.get("severity")
            bcol = RED if (pct >= 90 or sev in ("critical", "exceeded")) else (YEL if (pct >= 70 or sev == "warning") else GRN)
            p.append("  " + vpad(label, 9) + c(bcol, bar(pct, 14)) + f" {int(round(pct)):>3}%  " + c(DIM, f"resets {cd}"))
        stale = time.time() - _USAGE["ok_t"] if _USAGE["ok_t"] else 0
        retry = dur(_USAGE["next_t"] - time.time())
        if _USAGE["err"] and stale > USAGE_EVERY * 2:
            p.append("  " + c(DIM, f"stale {dur(stale)} ({_USAGE['err']}, retry {retry})"))
        p.append("  " + vpad("codex", 9) + c(DIM, "not configured"))
    else:
        note = "waiting for usage..." if (_USAGE["ok_t"] == 0 and not _USAGE["err"]) \
            else f"usage unavailable ({_USAGE['err'] or '...'}, retry {dur(_USAGE['next_t'] - time.time())}) - throttle only"
        p.append("  " + c(DIM, note))
        for typ, (tv, q) in sorted(scan_limits().items(), key=lambda kv: LIMIT_LABEL.get(kv[0], kv[0])):
            label = LIMIT_LABEL.get(typ, typ)
            resets = q.get("resetsAt", 0) or 0
            if q.get("status") == "rejected" and resets > time.time():
                p.append("  " + vpad(label, 9) + c(RED, f"LIMITED, resets {dur(resets - time.time())}"))
            else:
                p.append("  " + vpad(label, 9) + c(GRN, "ok"))
    panels.append(p)

    # AGENTS (parse each live session's transcript once, reuse for THROUGHPUT)
    sessions = read_sessions()
    procs, panes = my_procs(), tmux_panes()
    agent_pids = {}                         # pid -> label, reused by the TASKS panel
    agents = []
    stale = 0
    seen = set()
    for s in sessions:
        if pid_alive(s.get("pid")):
            sid = s.get("sessionId", "")
            if sid and sid in seen:        # same session double-registered (e.g. reused pid file)
                continue
            seen.add(sid)
            label = session_label(s, procs, panes)
            agent_pids[int(s["pid"])] = label
            agents.append((label, agent_stats(sid) or {}))
        else:
            stale += 1
    agents.sort(key=lambda t: t[0])
    p = [c(CYN, f" AGENTS ({len(agents)} live" + (f", {stale} off" if stale else "") + ")"),
         c(DIM, "  " + "label".ljust(15) + "idle".ljust(8) + "doing".ljust(15) + "br".ljust(5) + "ctx".ljust(11))]
    if not agents:
        p.append(c(DIM, "  (no live sessions here)"))
    for label, st in agents:
        last = st.get("last_ts")
        idle = (now_utc() - last).total_seconds() if last else 1e9
        active = idle < ACTIVE_WINDOW
        # colour the idle timer by proximity to the prompt-cache TTL (decache risk)
        if active:
            scol, marker = GRN, "*"
        elif idle >= CACHE_TTL:
            scol, marker = RED, "!"                # past TTL: context almost certainly decached
        elif idle >= 0.85 * CACHE_TTL:
            scol, marker = RED, " "                # imminent decache
        elif idle >= 0.60 * CACHE_TTL:
            scol, marker = YEL, " "
        else:
            scol, marker = GRY, " "
        # context-window fill from the last turn's prompt size
        ctx = st.get("ctx", 0)
        win = CTX_WINDOW or (1_000_000 if ctx > 200_000 else 200_000)
        cpct = min(100, int(round(100 * ctx / win))) if ctx else 0
        ccol = RED if cpct >= 85 else (YEL if cpct >= 70 else GRN)
        ctx_txt = f"{kfmt(ctx)} {cpct}%" if ctx else "-"
        p.append("  " + vpad(label, 15)
                 + vpad(f"{marker} {hms(last)}", 8, scol)
                 + vpad(st.get("doing", "-"), 15, YEL if active else GRY)
                 + vpad(st.get("branch", "-") or "-", 5)
                 + vpad(ctx_txt, 11, ccol))
    panels.append(p)

    # TASKS: per-user task/memory cap and who is using it
    panels.append(tasks_panel(procs, panes, agent_pids))

    # THROUGHPUT (proxy)
    total_recent = sum(st.get("recent_tok", 0) for _, st in agents)
    rate = total_recent / (RECENT_WINDOW / 60.0)
    panels.append([
        c(MAG, " THROUGHPUT ") + c(DIM, "out-tok proxy"),
        f"  last {RECENT_WINDOW//60}m: {c(BOLD, kfmt(total_recent))}  ~{c(BOLD, kfmt(rate))}/min",
    ])

    # SLURM
    jobs, err = squeue_jobs()
    if err:
        panels.append([c(BLU, " SLURM ") + c(YEL, err)])
    else:
        run = [j for j in jobs if j["st"] == "RUNNING"]
        pend = [j for j in jobs if j["st"] == "PENDING"]
        p = [c(BLU, f" SLURM ({len(run)} run, {len(pend)} pend)")]
        for j in (run + pend)[:8]:
            stc = c(GRN, "R") if j["st"] == "RUNNING" else c(YEL, "P")
            p.append("  " + stc + " " + vpad(j["id"], 11) + vpad(j["name"], 15) + f"{j['time']:>7} " + j["reason"][:13])
        if len(run) + len(pend) > 8:
            p.append(c(DIM, f"  ... +{len(run)+len(pend)-8} more"))
        panels.append(p)

    # NODES
    nodes = os.environ.get("VIBE_NODES", "submit01 submit02 submit03 submit04").split()
    cells = []
    for n in nodes:
        fq = f"{n}.{dom}" if dom else n
        cells.append(c(GRN, n) if node_reach(fq) else c(RED, n + "!"))
    panels.append([c(CYN, " NODES"), "  " + "  ".join(cells)])

    body = columnize(panels, width)
    footer = ["", c(DIM, f" q quit   idle {c(GRN,'*')} {c(GRY,'fresh')} {c(YEL,'>'+str(int(0.6*CACHE_TTL/60))+'m')} {c(RED,'>'+str(int(0.85*CACHE_TTL/60))+'m')}  cache {int(CACHE_TTL/60)}m")]
    return header + [""] + body + footer

def main():
    interval = 3.0
    for a in sys.argv[1:]:
        try:
            interval = max(1.0, float(a)); break
        except Exception:
            pass
    istty = sys.stdin.isatty() and sys.stdout.isatty()
    old = None
    if istty:
        import termios, tty
        old = termios.tcgetattr(sys.stdin)
        tty.setcbreak(sys.stdin.fileno())
        sys.stdout.write("\033[?25l\033[?1049h")  # hide cursor, alt screen
    try:
        while True:
            width = shutil.get_terminal_size((80, 24)).columns
            lines = build(width)
            out = "\033[H\033[2J" if istty else "\n"
            sys.stdout.write(out + "\r\n".join(lines) + "\r\n")
            sys.stdout.flush()
            if istty:
                r, _, _ = select.select([sys.stdin], [], [], interval)
                if r:
                    ch = sys.stdin.read(1)
                    if ch in ("q", "Q"):
                        break
            else:
                time.sleep(interval)
    except KeyboardInterrupt:
        pass
    finally:
        if istty and old is not None:
            import termios
            sys.stdout.write("\033[?25h\033[?1049l")  # show cursor, leave alt screen
            sys.stdout.flush()
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old)

if __name__ == "__main__":
    main()
